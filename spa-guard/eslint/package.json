{
  "name": "@ovineko/spa-guard-eslint",
  "version": "0.0.3-alpha-0",
  "description": "ESLint rules for spa-guard (no-direct-lazy, no-direct-error-boundary)",
  "keywords": [
    "spa",
    "eslint",
    "lint"
  ],
  "homepage": "https://github.com/ovineko/ovineko/tree/main/spa-guard/eslint",
  "bugs": {
    "url": "https://github.com/ovineko/ovineko/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ovineko/ovineko.git",
    "directory": "spa-guard/eslint"
  },
  "license": "MIT",
  "author": "Alexander Svinarev <shibanet0@gmail.com> (shibanet0.com)",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "prepack": "clean-pkg-json clean",
    "postpack": "clean-pkg-json restore",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:debug": "DEBUG=1 vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@ovineko/clean-pkg-json": "workspace:*",
    "@ovineko/datamitsu-config": "workspace:*",
    "@shibanet0/datamitsu-config": "0.0.3-alpha-27",
    "@types/node": "24.10.12",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "10.3.0",
    "tsdown": "0.22.0",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "eslint": "^9 || ^10"
  },
  "publishConfig": {
    "access": "public"
  }
}
